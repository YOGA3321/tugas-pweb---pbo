<UserControl x:Class="SkillForge.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="960"
             Background="{DynamicResource AppBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- HEADER                                                         -->
        <!-- ============================================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Manajemen Portofolio Proyek" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Kelola rekam jejak tugas besar kuliah dan karya mandiri Anda sebagai bukti kompetensi terverifikasi." 
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ============================================================== -->
        <!-- ACTION & SEARCH BAR                                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" 
                Padding="16,12" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input Container with Vector Search Icon -->
                <Border Grid.Column="0" Background="{DynamicResource InnerCardBgBrush}" 
                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" 
                        CornerRadius="6" Height="36" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource GeomSearch}" 
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" 
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" VerticalAlignment="Center" 
                                 Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Export Button -->
                    <Button Command="{Binding ExportPortfolioCommand}"
                            Style="{StaticResource ShadcnOutlineButtonStyle}"
                            Height="36" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomDownload}" 
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" 
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ekspor Portofolio (.md)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Add Project Button -->
                    <Button Command="{Binding OpenAddProjectCommand}"
                            Style="{StaticResource ShadcnPrimaryButtonStyle}"
                            Height="36">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomPlus}" 
                                  Stroke="{DynamicResource PrimaryBtnFgBrush}" StrokeThickness="1.8" 
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tambah Proyek" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- DATA TABLE CARD                                                -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" 
                Padding="20" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Daftar Portofolio Terdaftar" FontSize="15" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Sinkronisasi SQL Server Real-time" 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" 
                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredProjects}" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrushColor}" 
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource InnerCardBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="42"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource InnerCardBgBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProjectId}" Width="60"/>
                        <DataGridTextColumn Header="Judul Karya Proyek" Binding="{Binding Title}" Width="2.2*" FontWeight="Medium"/>
                        <DataGridTextColumn Header="Mata Kuliah / Asal" Binding="{Binding CourseName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Kompleksitas" Binding="{Binding DifficultyDisplay}" Width="130"/>
                        <DataGridTextColumn Header="Repositori GitHub" Binding="{Binding RepoUrl}" Width="2*"/>
                        <DataGridTextColumn Header="Tgl Dibuat" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>