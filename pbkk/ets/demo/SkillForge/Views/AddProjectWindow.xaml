<Window x:Class="SkillForge.Views.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Karya Portofolio Baru" 
        Height="500" Width="540" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource CardBgBrush}">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tambah Karya Portofolio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Catat detail tugas besar atau proyek mandiri Anda sebagai aset asesmen magang." 
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <Border Height="1" Background="{DynamicResource BorderBrushColor}" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="1">
                <!-- Judul Proyek -->
                <TextBlock Text="Judul Karya Proyek *" FontWeight="Medium" FontSize="12" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTitle" Height="36" VerticalContentAlignment="Center" 
                         Padding="10,0" Margin="0,0,0,14" FontSize="12"
                         Background="{DynamicResource InnerCardBgBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Mata Kuliah / Asal -->
                <TextBlock Text="Mata Kuliah / Asal Proyek *" FontWeight="Medium" FontSize="12" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtCourse" Height="36" VerticalContentAlignment="Center" 
                         Padding="10,0" Margin="0,0,0,14" FontSize="12" 
                         Background="{DynamicResource InnerCardBgBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                         Text="Pemrograman Berbasis Kerangka Kerja">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Tingkat Kesulitan -->
                <TextBlock Text="Tingkat Kompleksitas *" FontWeight="Medium" FontSize="12" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbDifficulty" Height="36" VerticalContentAlignment="Center" 
                          Padding="10,0" Margin="0,0,0,14" FontSize="12" SelectedIndex="1"
                          Background="{DynamicResource InnerCardBgBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrushColor}">
                    <ComboBoxItem Content="1 - Dasar / Pemula"/>
                    <ComboBoxItem Content="2 - Menengah"/>
                    <ComboBoxItem Content="3 - Kompleks / Lanjutan"/>
                </ComboBox>

                <!-- URL GitHub -->
                <TextBlock Text="Tautan Repositori GitHub" FontWeight="Medium" FontSize="12" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtRepo" Height="36" VerticalContentAlignment="Center" 
                         Padding="10,0" Margin="0,0,0,8" FontSize="12" 
                         Background="{DynamicResource InnerCardBgBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                         Text="https://github.com/">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Batal" Width="90" Height="36" Margin="0,0,10,0" 
                        Style="{StaticResource ShadcnOutlineButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button Content="Simpan Proyek" Width="130" Height="36" 
                        Style="{StaticResource ShadcnPrimaryButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>